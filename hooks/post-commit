#!/bin/sh
# generated by backd8 install; repo-local hooks are forwarded to, because a global hooksPath would otherwise disable them
d="$(cd "$(dirname "$0")/.." && (pwd -W 2>/dev/null || pwd))"
if [ -f "$d/backdate.ps1" ] && grep -Eq '"enabled":[[:space:]]*true' "${BACKDATE_CONFIG:-$d/config.json}" 2>/dev/null; then powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$d/backdate.ps1" hook; fi
h="$(git rev-parse --git-common-dir)/hooks/$(basename "$0")"
[ -f "$h" ] && exec "$h" "$@"
exit 0
